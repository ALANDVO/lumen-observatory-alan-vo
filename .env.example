# Application
APP_NAME=lumen-observatory
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/lumen.db

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC/Keycloak
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/lumen
OIDC_CLIENT_ID=lumen-observatory
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3000/callback

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Telemetry
OTLP_ENDPOINT=http://169.254.17.1:4317
TELEMETRY_ENABLED=true